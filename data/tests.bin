  "TC-TS-NEXTECH-001": {
    "id": "TC-TS-NEXTECH-001",
    "title": "nextech homepage smoke test",
    "description": "Smoke test for nextech homepage used by demo fixtures",
    "typeOfTest": "functional",
    "status": "passed",
    "steps": [
      {
        "action": "goto",
        "url": "https://www.nextech.com"
      },
      {
        "action": "eval",
        "script": "(() => { const t = document.title || ''; const ok = t.toLowerCase().includes('nextech'); if (!ok) throw new Error('title does not include nextech: ' + t); return t; })()"
      },
      {
        "action": "screenshot",
        "path": "artifacts/TC-TS-NEXTECH-001.png"
      }
    ],
    "lastRun": {
      "passed": true,
      "logs": "goto https://www.nextech.com\neval -> EHR Software & Practice Management for Specialty Physicians | Nextech\nscreenshot -> artifacts/TC-TS-NEXTECH-001.png"
    }
  }
